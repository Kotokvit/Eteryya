{
  "manifest_version": 3,
  "name": "POLER WebLens — Universal Harvester",
  "version": "2.0.0",
  "description": "Универсальный потоковый комбайн: пакетный сбор диалогов (Grok, ChatGPT, Claude, Gemini, DeepSeek, NotebookLM) и облачных папок (Google Drive, OneDrive) в poler-engine через MCP-шлюз 127.0.0.1:8765. Плюс резонансный поиск по всем индексам движка.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "POLER WebLens — Alt+P захват ветки в POLER",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "description": "Открыть панель WebLens (поиск по индексам)"
    },
    "harvest-thread": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Захватить ветку/папку в POLER"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
