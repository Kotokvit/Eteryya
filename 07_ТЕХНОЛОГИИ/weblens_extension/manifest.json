{
  "manifest_version": 3,
  "name": "POLER WebLens — Архиватор",
  "version": "2.1.0",
  "description": "Человеко-удобный архиватор в POLER: правый клик → «в POLER», клик по иконке → Ctrl+V → «Архивировать», Alt+P — захват ветки ИИ-чата, DropZone — перетащить файлы. Плюс поиск по индексам движка.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "omnibox"
  ],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "poler"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "POLER Архиватор — клик, Ctrl+V, «Архивировать» (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "description": "Открыть архиватор (вставить и отправить)",
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    },
    "harvest-thread": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Захватить ветку/папку в POLER"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
